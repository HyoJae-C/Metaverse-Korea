77.2,139.4],[-198,-198.5]]},{"k":"grass","p":[[-202.1,-194],[173.2,143.9],[167.2,150.6],[-208.1,-187.4]]},{"k":"grass","lawn":true,"p":[[-52.7,-59.5],[32,16.7],[26.8,22.5],[-57.9,-53.8]]},{"k":"water","p":[[-222.9,-200.7],[182.1,163.9],[28.2,334.9],[-376.8,-29.8]]}],"blockers":[{"p":[[-222.9,-200.7],[182.1,163.9],[28.2,334.9],[-376.8,-29.8]]}],"pois":[{"kind":"landmark","x":92.65,"z":-196.95,"name":{"ko":"망원시장","en":"Mangwon Market","ja":"望遠市場","zh":"望远市场"}},{"kind":"landmark","x":85.8,"z":-112.9,"name":{"ko":"망리단길","en":"Mangridan-gil","ja":"望理団通り","zh":"望理团路"}},{"kind":"landmark","x":-117.2,"z":-132.4,"name":{"ko":"망원한강공원","en":"Mangwon Han River Park","ja":"望遠漢江公園","zh":"望远汉江公园"}}],"landmarks":[{"type":"arch","x":78.4,"z":-247.2,"w":10,"ry":3.4,"title":"MANGWON MARKET","sub":"망원시장","color":"#c0392b"},{"type":"arch","x":106.9,"z":-146.7,"w":10,"ry":0.3,"title":"MANGWON MARKET","sub":"망원시장","color":"#c0392b"},{"type":"arcade","x":92.65,"z":-196.95,"ry":0.3,"len":100.5,"w":12,"h":6.2,"gap":12},{"type":"arch","x":85.8,"z":-112.9,"w":10,"ry":0.3,"title":"MANGRIDAN-GIL","sub":"망리단길 · 포은로","color":"#6a4c93"},{"type":"arch","x":-111.8,"z":-138.4,"w":8,"ry":2.4,"title":"MANGWON HAN RIVER PARK","sub":"망원한강공원","color":"#2f78b0"},{"type":"sign","x":-110.9,"z":-121.4,"ry":-0.7,"title":{"ko":"망원한강공원","en":"Mangwon Han River Park","ja":"望遠漢江公園","zh":"望远汉江公园"},"text":{"en":"A riverside park on the north bank of the Han River. Walk or cycle along the water, spread a mat on the grass, or try your luck at the fishing pier: some fish only bite here.","ko":"한강 북쪽 강변의 공원이에요. 강을 따라 걷거나 자전거를 타고, 잔디에 돗자리를 펴거나, 낚시 선착장에서 낚시를 해 보세요. 여기서만 잡히는 물고기도 있어요.","ja":"漢江の北岸にある川辺の公園です。川沿いを歩いたり自転車に乗ったり、芝生にシートを広げたり、釣り桟橋で釣りをしてみましょう。ここでしか釣れない魚もいます。","zh":"汉江北岸的江边公园。沿着江边散步、骑车，在草地上铺开野餐垫，或者去钓鱼码头碰碰运气：有些鱼只在这里咬钩。"}},{"type":"sign","x":-84.4,"z":-97.5,"ry":-0.7,"title":{"ko":"서울함 공원","en":"Seoul Battleship Park","ja":"ソウル艦公園","zh":"首尔舰公园"},"text":{"en":"Three retired Korean Navy ships are moored at Mangwon Han River Park: a frigate, a patrol boat and a submarine. Since 2017 you can go aboard and see how sailors lived. In the game, the grey frigate is just to look at from the bank.","ko":"망원한강공원에는 퇴역한 해군 함정 세 척이 정박해 있어요. 호위함, 고속정, 잠수함이에요. 2017년부터 배에 올라가 수병들이 어떻게 지냈는지 볼 수 있어요. 게임에서는 회색 호위함을 강가에서 구경만 할 수 있어요.","ja":"望遠漢江公園には、退役した韓国海軍の艦艇3隻が停泊しています。護衛艦、高速艇、潜水艦です。2017年から船に乗って、水兵の暮らしを見学できます。ゲームでは灰色の護衛艦を岸から眺めるだけです。","zh":"望远汉江公园停泊着三艘退役的韩国海军舰艇：一艘护卫舰、一艘快艇和一艘潜艇。从2017年起可以登船参观水兵的生活。在游戏里，灰色的护卫舰只能在岸边观看。"}},{"type":"bench","x":-207.6,"z":-196.4,"ry":2.4},{"type":"bench","x":-59,"z":-62.5,"ry":2.4},{"type":"bench","x":-29.3,"z":-35.8,"ry":2.4},{"type":"bench","x":0.4,"z":-9,"ry":2.4},{"type":"bench","x":30.2,"z":17.7,"ry":2.4},{"type":"hanpark","store":"mangwon-hangang","x":-85.5,"z":-77,"ry":2.4,"bounds":[-195,-45,155,13],"layout":{"paving":[[30,0.4,82,9.2,"#d9c7a6"]],"rail":[-188,150],"pier":{"x":-20,"len":9},"fishBuy":[-12,4.2,0],"fishing":[[-46,0.75],[-26,0.75],[-20,-8.2],[-60,0.75]],"kiosk":[42,6.6,3.141592653589793],"tables":[[33.6,3.4],[49.6,3.4]],"market":{"spots":[[66.4,7.6,3.141592653589793],[69.2,7.6,3.141592653589793],[72,7.6,3.141592653589793],[74.8,7.6,3.141592653589793]],"tables":[[70.6,3.6],[78.4,4.6]],"board":[79.6,8.2,3.141592653589793]},"dock":104,"duckWater":{"minX":86,"maxX":126,"minZ":-38},"ships":[[23,-13,40]],"lamps":[[-40,2.6],[-4,2.6],[28,2.6],[56,2.6],[88,2.6],[120,2.6],[148,2.6]],"benches":[[118,3.4],[138,3.4],[146,3.4]],"beds":[[-6,6.4,3],[56,8.6,2.6],[88,6.4,3]],"trees":[[-84,7.2],[128,7.4],[150,7]],"bushes":[[-34,7.6],[24,8],[92,8.2]]}}]}
