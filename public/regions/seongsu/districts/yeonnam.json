100],[68,100],[32,100]]},{"k":"plaza","p":[[34,84],[66,84],[66,100],[34,100]]}],"blockers":[],"pois":[{"kind":"landmark","x":50,"z":0,"name":{"ko":"경의선숲길","en":"Gyeongui Line Forest Park","ja":"京義線森の道","zh":"京义线林荫路"}},{"kind":"landmark","x":-40,"z":30,"name":{"ko":"연남동 중식당 거리","en":"Yeonnam-dong Chinese restaurants","ja":"延南洞の中華料理店","zh":"延南洞中餐馆"}}],"landmarks":[{"type":"arch","x":50,"z":96,"w":9,"title":"GYEONGUI LINE FOREST PARK","sub":"경의선숲길 · 연남동","color":"#3f7a4f"},{"type":"arch","x":50,"z":-96,"w":9,"ry":3.141592653589793,"title":"GYEONGUI LINE FOREST PARK","sub":"경의선숲길 · 연남동","color":"#3f7a4f"},{"type":"tracks","x":61,"z":0,"len":180},{"type":"sign","x":42,"z":80,"ry":1.5707963267948966,"title":{"ko":"경의선숲길","en":"Gyeongui Line Forest Park","ja":"京義線森の道","zh":"京义线林荫路"},"text":{"en":"Trains on the old Gyeongui Line ran here. When the line went underground, the track bed became a long, narrow park. People call this stretch \"Yeontral Park\". Bring a picnic mat!","ko":"옛 경의선 기차가 달리던 길이에요. 철길이 지하로 들어간 뒤 그 자리가 길고 좁은 공원이 됐어요. 이 구간을 사람들은 \"연트럴파크\"라고 불러요. 돗자리를 챙겨 오세요!","ja":"かつて京義線の列車が走っていた道です。線路が地下に移ったあと、跡地が細長い公園になりました。この区間は「ヨントラルパーク」と呼ばれています。レジャーシートを持ってきてね！","zh":"这里曾是旧京义线火车经过的地方。铁路转入地下后，原来的路基变成了一条细长的公园。人们把这一段叫作“延特尔公园”。记得带野餐垫！"}},{"type":"bench","x":44,"z":-80,"ry":1.5707963267948966},{"type":"bench","x":56,"z":-68,"ry":-1.5707963267948966},{"type":"bench","x":44,"z":-55,"ry":1.5707963267948966},{"type":"bench","x":56,"z":-43,"ry":-1.5707963267948966},{"type":"bench","x":44,"z":10,"ry":1.5707963267948966},{"type":"bench","x":56,"z":22,"ry":-1.5707963267948966},{"type":"bench","x":44,"z":35,"ry":1.5707963267948966},{"type":"bench","x":56,"z":47,"ry":-1.5707963267948966},{"type":"bench","x":44,"z":60,"ry":1.5707963267948966},{"type":"bench","x":56,"z":72,"ry":-1.5707963267948966}]}
